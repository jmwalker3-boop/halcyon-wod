  "description": "Resolves one coach-authored workout to an individual athlete's actual Rx: flags equipment gaps, rounds loads to what the athlete actually owns.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./context": "./dist/context.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/__tests__/*.test.ts",
    "test:integration": "tsx --test src/__tests__/integration/*.test.ts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsx": "^4.19.2"
  }
}
